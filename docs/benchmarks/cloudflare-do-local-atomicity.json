{
  "date": "2026-10-19",
  "scope": "Local workerd HTTP; isolates SingleFileFS deferred host-store writes. No real Cloudflare deployment.",
  "environment": {
    "os": "Linux",
    "arch": "x86_64",
    "node": "v24.19.0",
    "pglite": "0.5.8",
    "wrangler": "4.151.1",
    "workerd": "1.20261012.1",
    "workerConfig": {
      "name": "pglite-do-example",
      "main": "src/worker.mjs",
      "compatibility_date": "2026-10-01",
      "compatibility_flags": [
        "nodejs_compat"
      ],
      "define": {
        "import.meta.url": "\"file:///pglite/index.js\""
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DB",
            "class_name": "Db"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "Db"
          ]
        }
      ],
      "rules": [
        {
          "type": "CompiledWasm",
          "globs": [
            "**/*.wasm"
          ],
          "fallthrough": true
        },
        {
          "type": "Data",
          "globs": [
            "**/*.data"
          ],
          "fallthrough": true
        }
      ]
    }
  },
  "sources": {
    "baselineCommit": "b5d1b853111b50ab23b2fba2694a45a92e5df1ee",
