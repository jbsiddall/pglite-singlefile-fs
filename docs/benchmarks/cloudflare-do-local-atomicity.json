  "method": {
    "order": [
      "before1",
      "after1",
      "after2",
      "before2",
      "before3",
      "after3"
    ],
    "freshStoragePerVariant": true,
    "sameSeedImage": true,
    "sameWorkerCodeExceptSingleFileFs": true,
    "warmup": "GET /stats starts each engine before measured suites; no full workload warmup excluded",
    "cache": "OS caches not cleared; three suites per variant reuse each initialized database and drop/recreate benchmark tables",
    "requestBody": "one SQL statement per HTTP request",
    "client": "Node fetch on same Linux host using localhost:8800/8801",
    "durability": "DurableObjectStore supplied ctx.storage.transactionSync; default PGlite strict persistence",
    "metadataWorkload": "20 cycles of separate CREATE TABLE, INSERT 100 rows, TRUNCATE, DROP TABLE requests; median across 80 requests",
    "bulkUpdateRows": 20100,
    "exclusions": "Earlier exploratory runs used different Worker code between variants or failed token setup. They are not the isolated comparison and are not substituted for these three complete pairs."
  },
  "limits": [
    "Three runs cannot establish a universal cost or statistical significance.",
    "Bulk insert/update have one sample per suite; per-suite p95 is not informative.",
    "Local workerd does not establish 128 MB production compliance, durable commit latency or remote cold starts.",
    "Comparison changes filesystem persistence behavior; it is not equal crash safety before and after."
  ],
