{
  "name": "pglite-do-example",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "mkdir -p assets && cp ../../node_modules/@electric-sql/pglite/dist/pglite.wasm ../../node_modules/@electric-sql/pglite/dist/initdb.wasm ../../node_modules/@electric-sql/pglite/dist/pglite.data assets/ && node scripts/capture-trampolines.mjs",
    "dev": "npm run prepare-assets && wrangler dev --local --persist-to .state",
    "ws-bridge": "node scripts/ws-bridge.mjs",
    "test:drizzle": "node scripts/drizzle-smoke.mjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "check:prisma": "tsc --noEmit --target ES2023 --module NodeNext --moduleResolution NodeNext --strict --allowJs --esModuleInterop --allowImportingTsExtensions --skipLibCheck scripts/prisma-smoke.ts",
    "test:prisma": "tsx scripts/prisma-smoke.ts",
    "test:prisma:ws": "tsx scripts/prisma-smoke.ts --ws"
  },
  "devDependencies": {
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/ws": "8.18.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "ws": "8.22.0"
  }
}
